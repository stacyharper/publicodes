{
	"name": "compiler-benchmarks-js",
	"private": true,
	"version": "2.0.0-alpha.0",
	"description": "Publicodes JS runtime benchmark on real-world examples",
	"type": "module",
	"license": "MIT",
	"devDependencies": {
		"@mitata/counters": "^0.0.8",
		"@publicodes/cli": "workspace:^",
		"@publicodes/tools": "workspace:^",
		"bun": "^1.3.11",
		"mitata": "^1.0.34",
		"publicodes": "workspace:^",
		"typescript": "^5.9.2"
	},
	"scripts": {
		"test:type": "tsc --noEmit",
		"compile:auto-entrepreneur": "cd ./examples/auto-entrepreneur; publicodes compile '*.publicodes'; ../../../../_build/default/bin/main.exe compile *.publicodes",
		"compile:simple-TJM": "cd ./examples/simple-TJM; publicodes compile '*.publicodes'; ../../../../_build/default/bin/main.exe compile *.publicodes;",
		"compile": "run compile:auto-entrepreneur && run compile:simple-TJM",
		"benchmark:simple-TJM": "bun --expose-gc ./examples/simple-TJM/index.ts",
		"benchmark:auto-entrepreneur": "bun --expose-gc ./auto-entrepreneur.js",
		"benchmark": "run benchmark:simple-TJM && run benchmark:auto-entrepreneur",
		"start": "run compile && run benchmark"
	}
}
